# AST-GuardCache Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for live LLM queries)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter Model (default: cohere/north-mini-code:free)
OPENROUTER_MODEL=cohere/north-mini-code:free

# Optional: any OpenAI-compatible endpoint instead of OpenRouter.
# Local Ollama (free): OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1 and OPENROUTER_MODEL=qwen2.5-coder:7b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
