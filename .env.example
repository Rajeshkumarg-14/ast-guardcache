# AST-GuardCache Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required for live LLM queries)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter Model (default: qwen/qwen-2.5-coder-32b-instruct)
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
